+static int remote_init_stream(struct bladerf_stream **stream,
+                              struct bladerf *dev,
+                              bladerf_stream_cb callback,
+                              void ***buffers,
+                              size_t num_buffers,
+                              bladerf_format format,
+                              size_t samples_per_buffer,
+                              size_t num_transfers,
+                              void *user_data)
+{
+    struct remote_board_data *bd = dev->board_data;
+    struct bladerf_stream *lstream;
+    size_t buf_bytes;
+    size_t i;
+
+    if (!stream || !callback || num_buffers == 0 || samples_per_buffer == 0 ||
+        num_transfers > num_buffers) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    buf_bytes = samples_to_bytes(format, samples_per_buffer);
+    if (buf_bytes == 0 || buf_bytes > REMOTE_MAX_PAYLOAD) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    lstream = calloc(1, sizeof(*lstream));
+    if (!lstream) {
+        return BLADERF_ERR_MEM;
+    }
+
+    MUTEX_INIT(&lstream->lock);
+    lstream->dev = dev;
+    lstream->state = STREAM_IDLE;
+    lstream->samples_per_buffer = samples_per_buffer;
+    lstream->num_buffers = num_buffers;
+    lstream->format = format;
+    lstream->transfer_timeout = 1000;
+    lstream->cb = callback;
+    lstream->user_data = user_data;
+
+    lstream->buffers = calloc(num_buffers, sizeof(void *));
+    if (!lstream->buffers) {
+        free(lstream);
+        return BLADERF_ERR_MEM;
+    }
+
+    for (i = 0; i < num_buffers; i++) {
+        lstream->buffers[i] = calloc(1, buf_bytes);
+        if (!lstream->buffers[i]) {
+            size_t j;
+            for (j = 0; j < i; j++) {
+                free(lstream->buffers[j]);
+            }
+            free(lstream->buffers);
+            free(lstream);
+            return BLADERF_ERR_MEM;
+        }
+    }
+
+    bd->stream_num_transfers = (uint32_t)num_transfers;
+    if (buffers != NULL) {
+        *buffers = lstream->buffers;
+    }
+    *stream = lstream;
+    return 0;
+}
+
+static size_t find_stream_buf_idx(struct bladerf_stream *stream,
+                                  void *ptr,
+                                  size_t fallback)
+{
+    size_t i;
+    for (i = 0; i < stream->num_buffers; i++) {
+        if (stream->buffers[i] == ptr) {
+            return i;
+        }
+    }
+    return (fallback + 1) % stream->num_buffers;
+}
+
+static int remote_stream(struct bladerf_stream *stream,
+                         bladerf_channel_layout layout)
+{
+    struct bladerf *dev;
+    struct remote_dev_ctx *ctx;
+    struct remote_board_data *bd;
+    struct remote_conn sconn;
+    struct remote_stream_start_req req;
+    size_t buf_bytes;
+    size_t cur_idx = 0;
+    int status;
+    bool is_tx;
+
+    if (!stream || !stream->dev || !stream->dev->backend_data) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    dev = stream->dev;
+    ctx = dev->backend_data;
+    bd = dev->board_data;
+    is_tx = (layout == BLADERF_TX_X1 || layout == BLADERF_TX_X2);
+    buf_bytes = samples_to_bytes(stream->format, stream->samples_per_buffer);
+
+    status = remote_connect(ctx->host, ctx->port, ctx->prefer_rdma, &sconn);
+    if (status != 0) {
+        return status;
+    }
+
+    memset(&req, 0, sizeof(req));
+    req.layout = (int32_t)layout;
+    req.format = (int32_t)stream->format;
+    req.samples_per_buffer = (uint32_t)stream->samples_per_buffer;
+    req.num_buffers = (uint32_t)stream->num_buffers;
+    req.num_transfers = bd->stream_num_transfers ? bd->stream_num_transfers : 1u;
+    req.timeout_ms = stream->transfer_timeout;
+
+    status = remote_rpc(&sconn, NULL, REMOTE_OP_STREAM_START,
+                        &req, sizeof(req), NULL, 0, NULL);
+    if (status != 0) {
+        remote_close_conn(&sconn);
+        return status;
+    }
+
+    stream->layout = layout;
+    stream->state = STREAM_RUNNING;
+
+    while (stream->state == STREAM_RUNNING) {
+        struct bladerf_metadata meta;
+        struct remote_stream_frame_hdr fhdr;
+        void *next_buf = NULL;
+
+        memset(&meta, 0, sizeof(meta));
+        memset(&fhdr, 0, sizeof(fhdr));
+
+        if (!is_tx) {
+            status = remote_recv_all(&sconn, &fhdr, sizeof(fhdr));
+            if (status != 0) {
+                break;
+            }
+            if (fhdr.status != 0) {
+                status = fhdr.status;
+                break;
+            }
+            if (fhdr.byte_len > buf_bytes) {
+                status = BLADERF_ERR_UNEXPECTED;
+                break;
+            }
+            if (fhdr.byte_len > 0) {
+                status = remote_recv_all(&sconn, stream->buffers[cur_idx], fhdr.byte_len);
+                if (status != 0) {
+                    break;
+                }
+            }
+
+            meta.timestamp = fhdr.timestamp;
+            meta.flags = fhdr.flags;
+            meta.status = fhdr.meta_status;
+            meta.actual_count = fhdr.actual_count;
+
+            next_buf = stream->cb(dev, stream, &meta,
+                                  stream->buffers[cur_idx],
+                                  stream->samples_per_buffer,
+                                  stream->user_data);
+            if (next_buf == BLADERF_STREAM_SHUTDOWN) {
+                status = 0;
+                break;
+            }
+            if (next_buf != BLADERF_STREAM_NO_DATA && next_buf != NULL) {
+                cur_idx = find_stream_buf_idx(stream, next_buf, cur_idx);
+            } else {
+                cur_idx = (cur_idx + 1) % stream->num_buffers;
+            }
+        } else {
+            next_buf = stream->cb(dev, stream, &meta,
+                                  stream->buffers[cur_idx],
+                                  stream->samples_per_buffer,
+                                  stream->user_data);
+            if (next_buf == BLADERF_STREAM_SHUTDOWN) {
+                status = 0;
+                break;
+            }
+            if (next_buf == BLADERF_STREAM_NO_DATA || next_buf == NULL) {
+                cur_idx = (cur_idx + 1) % stream->num_buffers;
+                continue;
+            }
+
+            fhdr.status = 0;
+            fhdr.timestamp = meta.timestamp;
+            fhdr.flags = meta.flags;
+            fhdr.meta_status = meta.status;
+            fhdr.actual_count = (uint32_t)stream->samples_per_buffer;
+            fhdr.byte_len = (uint32_t)buf_bytes;
+
+            status = remote_send_all(&sconn, &fhdr, sizeof(fhdr));
+            if (status != 0) {
+                break;
+            }
+            status = remote_send_all(&sconn, next_buf, buf_bytes);
+            if (status != 0) {
+                break;
+            }
+            cur_idx = find_stream_buf_idx(stream, next_buf, cur_idx);
+        }
+    }
+
+    stream->state = STREAM_DONE;
+    remote_close_conn(&sconn);
+    return status;
+}
