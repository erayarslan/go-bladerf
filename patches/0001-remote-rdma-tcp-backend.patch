+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                srv->sim_dev.frequency[ch_idx(r->ch)] = r->val;
+            } else {
+                status = bladerf_set_frequency(srv->dev, (bladerf_channel)r->ch, r->val);
