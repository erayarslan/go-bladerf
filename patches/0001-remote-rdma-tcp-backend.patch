+#define REMOTE_LOG_DEBUG(...) fprintf(stderr, "[DEBUG] " __VA_ARGS__)
+#define REMOTE_LOG_ERROR(...) fprintf(stderr, "[ERROR] " __VA_ARGS__)
+#endif
