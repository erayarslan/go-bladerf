+static int remote_read_flash(struct bladerf *dev,
+                             uint8_t *buf,
+                             uint32_t page,
+                             uint32_t count)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    uint32_t psize = dev->flash_arch ? dev->flash_arch->psize_bytes : 256u;
+    uint64_t total_bytes = (uint64_t)count * (uint64_t)psize;
+    struct remote_flash_req req;
+    uint32_t resp_len = 0;
+
+    if (!buf || total_bytes > REMOTE_MAX_PAYLOAD) {
+        return BLADERF_ERR_INVAL;
+    }
+    req.param1 = page;
+    req.param2 = count;
+    req.byte_len = (uint32_t)total_bytes;
+
+    return remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_READ_FLASH,
+                      &req, sizeof(req), buf, (uint32_t)total_bytes, &resp_len);
+}
+
+static int remote_write_flash(struct bladerf *dev,
+                              const uint8_t *buf,
+                              uint32_t page,
+                              uint32_t count)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    uint32_t psize = dev->flash_arch ? dev->flash_arch->psize_bytes : 256u;
+    uint64_t total_bytes = (uint64_t)count * (uint64_t)psize;
+    struct remote_flash_req req;
+    struct remote_msg_hdr hdr;
+    struct remote_msg_hdr resp_hdr;
+    int status;
+
+    if (!buf || total_bytes > REMOTE_MAX_PAYLOAD) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    req.param1 = page;
+    req.param2 = count;
+    req.byte_len = (uint32_t)total_bytes;
+
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.magic = REMOTE_PROTO_MAGIC;
+    hdr.opcode = REMOTE_OP_WRITE_FLASH;
+    hdr.payload_len = (uint32_t)(sizeof(req) + total_bytes);
+
+    pthread_mutex_lock(&ctx->ctrl_lock);
+    status = remote_send_all(&ctx->ctrl, &hdr, sizeof(hdr));
+    if (status == 0) {
+        status = remote_send_all(&ctx->ctrl, &req, sizeof(req));
+    }
+    if (status == 0 && total_bytes > 0) {
+        status = remote_send_all(&ctx->ctrl, buf, (size_t)total_bytes);
+    }
+    if (status == 0) {
+        status = remote_recv_all(&ctx->ctrl, &resp_hdr, sizeof(resp_hdr));
+    }
+    pthread_mutex_unlock(&ctx->ctrl_lock);
+
+    if (status != 0) {
+        return status;
+    }
+    if (resp_hdr.magic != REMOTE_PROTO_MAGIC ||
+        resp_hdr.opcode != REMOTE_OP_WRITE_FLASH) {
+        return BLADERF_ERR_UNEXPECTED;
+    }
+    return resp_hdr.status;
+}
