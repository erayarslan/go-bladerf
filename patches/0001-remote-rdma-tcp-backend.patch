+                    (bladerf_trigger_role)r->trigger.role,
+                    (bladerf_trigger_signal)r->trigger.signal,
+                    r->trigger.options
+                };
+                status = bladerf_trigger_arm(srv->dev, &trig, r->arm != 0,
+                                             r->resv1, r->resv2);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_TRIGGER_FIRE: {
+            const struct remote_trigger_wire *r =
+                (const struct remote_trigger_wire *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                srv->sim_dev.trig_fired = true;
+                srv->sim_dev.trig_fire_req = true;
+            } else {
+                struct bladerf_trigger trig = {
+                    (bladerf_channel)r->ch,
+                    (bladerf_trigger_role)r->role,
+                    (bladerf_trigger_signal)r->signal,
+                    r->options
+                };
+                status = bladerf_trigger_fire(srv->dev, &trig);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_TRIGGER_STATE: {
+            const struct remote_trigger_wire *r =
+                (const struct remote_trigger_wire *)req_buf;
+            struct remote_trigger_state_resp resp;
+            memset(&resp, 0, sizeof(resp));
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                resp.is_armed = srv->sim_dev.trig_armed ? 1 : 0;
+                resp.has_fired = srv->sim_dev.trig_fired ? 1 : 0;
+                resp.fire_requested = srv->sim_dev.trig_fire_req ? 1 : 0;
+            } else {
+                bool a = false, f = false, fr = false;
+                uint64_t r1 = 0, r2 = 0;
+                struct bladerf_trigger trig = {
+                    (bladerf_channel)r->ch,
+                    (bladerf_trigger_role)r->role,
+                    (bladerf_trigger_signal)r->signal,
+                    r->options
+                };
+                status = bladerf_trigger_state(srv->dev, &trig, &a, &f, &fr, &r1, &r2);
+                resp.is_armed = a ? 1 : 0;
+                resp.has_fired = f ? 1 : 0;
+                resp.fire_requested = fr ? 1 : 0;
+                resp.resv1 = r1;
+                resp.resv2 = r2;
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_READ_TRIGGER: {
+            const struct remote_trigger_rw_req *r =
+                (const struct remote_trigger_rw_req *)req_buf;
+            struct remote_u32_resp resp = { 0 };
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                resp.val = srv->sim_dev.trigger_reg[ch_idx(r->ch)];
+            } else {
+                uint8_t val = 0;
+                status = bladerf_read_trigger(srv->dev, (bladerf_channel)r->ch,
+                                              (bladerf_trigger_signal)r->signal, &val);
+                resp.val = val;
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_WRITE_TRIGGER: {
+            const struct remote_trigger_rw_req *r =
+                (const struct remote_trigger_rw_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                srv->sim_dev.trigger_reg[ch_idx(r->ch)] = r->val;
+            } else {
+                status = bladerf_write_trigger(srv->dev, (bladerf_channel)r->ch,
+                                               (bladerf_trigger_signal)r->signal, r->val);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_CONFIG_GPIO_READ: {
+            struct remote_u32_resp resp = { 0 };
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                resp.val = srv->sim_dev.config_gpio;
+            } else {
+                status = bladerf_config_gpio_read(srv->dev, &resp.val);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_CONFIG_GPIO_WRITE: {
+            const struct remote_u32_req *r = (const struct remote_u32_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                srv->sim_dev.config_gpio = r->val | 129u;
+            } else {
+                status = bladerf_config_gpio_write(srv->dev, r->val);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_GET_VCTCXO_TRIM: {
+            struct remote_u16_resp resp = { 0 };
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                resp.val = srv->sim_dev.trim_dac;
+            } else {
+                status = bladerf_get_vctcxo_trim(srv->dev, &resp.val);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_TRIM_DAC_READ: {
+            struct remote_u16_resp resp = { 0 };
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                resp.val = srv->sim_dev.trim_dac;
+            } else {
+                status = bladerf_trim_dac_read(srv->dev, &resp.val);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_TRIM_DAC_WRITE: {
+            const struct remote_u16_req *r = (const struct remote_u16_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                srv->sim_dev.trim_dac = r->val;
+            } else {
+                status = bladerf_trim_dac_write(srv->dev, r->val);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_SET_VCTCXO_TAMER_MODE: {
+            const struct remote_i32_req *r = (const struct remote_i32_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            if (srv->sim) {
+                status = BLADERF_ERR_UNSUPPORTED;
+            } else {
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_set_vctcxo_tamer_mode(srv->dev,
+                                                       (bladerf_vctcxo_tamer_mode)r->val);
+                pthread_mutex_unlock(&srv->dev_lock);
+            }
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_GET_VCTCXO_TAMER_MODE: {
+            struct remote_i32_resp resp = { BLADERF_VCTCXO_TAMER_INVALID };
+            if (srv->sim) {
+                status = BLADERF_ERR_UNSUPPORTED;
+            } else {
+                bladerf_vctcxo_tamer_mode m = BLADERF_VCTCXO_TAMER_INVALID;
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_get_vctcxo_tamer_mode(srv->dev, &m);
+                pthread_mutex_unlock(&srv->dev_lock);
+                resp.val = (int32_t)m;
+            }
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_EXPANSION_ATTACH: {
+            const struct remote_i32_req *r = (const struct remote_i32_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            if (srv->sim) {
+                status = BLADERF_ERR_UNSUPPORTED;
+            } else {
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_expansion_attach(srv->dev, (bladerf_xb)r->val);
+                pthread_mutex_unlock(&srv->dev_lock);
+            }
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_EXPANSION_GET_ATTACHED: {
+            struct remote_i32_resp resp = { BLADERF_XB_NONE };
+            if (!srv->sim) {
+                bladerf_xb xb = BLADERF_XB_NONE;
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_expansion_get_attached(srv->dev, &xb);
+                pthread_mutex_unlock(&srv->dev_lock);
+                resp.val = (int32_t)xb;
+            }
+            return send_reply(conn, hdr->opcode, status, &resp, sizeof(resp));
+        }
+
+        case REMOTE_OP_ERASE_FLASH: {
+            const struct remote_flash_req *r = (const struct remote_flash_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r)) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            if (!srv->sim) {
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_erase_flash(srv->dev, r->param1, r->param2);
+                pthread_mutex_unlock(&srv->dev_lock);
+            }
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_READ_FLASH: {
+            const struct remote_flash_req *r = (const struct remote_flash_req *)req_buf;
+            uint8_t *buf;
+            int rc;
+            if (hdr->payload_len < sizeof(*r) || r->byte_len > REMOTE_MAX_PAYLOAD) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            buf = calloc(1, r->byte_len ? r->byte_len : 1);
+            if (!buf) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_MEM, NULL, 0);
+            }
+            if (!srv->sim) {
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_read_flash(srv->dev, buf, r->param1, r->param2);
+                pthread_mutex_unlock(&srv->dev_lock);
+            }
+            rc = send_reply(conn, hdr->opcode, status, buf, status == 0 ? r->byte_len : 0);
+            free(buf);
+            return rc;
+        }
+
+        case REMOTE_OP_WRITE_FLASH: {
+            const struct remote_flash_req *r = (const struct remote_flash_req *)req_buf;
+            if (hdr->payload_len < sizeof(*r) ||
+                sizeof(*r) + r->byte_len > hdr->payload_len) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            if (!srv->sim) {
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_write_flash(srv->dev, req_buf + sizeof(*r),
+                                             r->param1, r->param2);
+                pthread_mutex_unlock(&srv->dev_lock);
+            }
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_READ_OTP: {
+            uint8_t otp[256];
+            memset(otp, 0, sizeof(otp));
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                memcpy(otp, srv->sim_dev.otp, sizeof(otp));
+            } else {
+                status = bladerf_read_otp(srv->dev, otp);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, otp, status == 0 ? 256 : 0);
+        }
+
+        case REMOTE_OP_WRITE_OTP: {
+            if (hdr->payload_len < 256) {
+                return send_reply(conn, hdr->opcode, BLADERF_ERR_INVAL, NULL, 0);
+            }
+            pthread_mutex_lock(&srv->dev_lock);
+            if (srv->sim) {
+                memcpy(srv->sim_dev.otp, req_buf, 256);
+            } else {
+                status = bladerf_write_otp(srv->dev, (uint8_t *)req_buf);
+            }
+            pthread_mutex_unlock(&srv->dev_lock);
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_LOCK_OTP: {
+            if (!srv->sim) {
+                pthread_mutex_lock(&srv->dev_lock);
+                status = bladerf_lock_otp(srv->dev);
+                pthread_mutex_unlock(&srv->dev_lock);
+            }
+            return send_reply(conn, hdr->opcode, status, NULL, 0);
+        }
+
+        case REMOTE_OP_LOAD_FPGA:
+            return send_reply(conn, hdr->opcode, BLADERF_ERR_UNSUPPORTED, NULL, 0);
+
+        default:
+            return send_reply(conn, hdr->opcode, BLADERF_ERR_UNSUPPORTED, NULL, 0);
+    }
+}
+
+struct client_arg {
+    struct server_state *srv;
+    struct remote_conn conn;
+};
+
+static void *client_thread(void *arg)
+{
+    struct client_arg *ca = (struct client_arg *)arg;
+    struct server_state *srv = ca->srv;
+    struct remote_conn conn = ca->conn;
+    bool done = false;
+
+    free(ca);
+
+    while (!done) {
+        struct remote_msg_hdr hdr;
+        uint8_t *payload = NULL;
+
+        if (remote_recv_all(&conn, &hdr, sizeof(hdr)) != 0) {
+            break;
+        }
+        if (hdr.magic != REMOTE_PROTO_MAGIC || hdr.payload_len > REMOTE_MAX_PAYLOAD) {
+            break;
+        }
+        if (hdr.payload_len > 0) {
+            payload = malloc(hdr.payload_len);
+            if (!payload) {
+                break;
+            }
+            if (remote_recv_all(&conn, payload, hdr.payload_len) != 0) {
+                free(payload);
+                break;
+            }
+        }
+
+        if (handle_rpc_request(srv, &conn, &hdr, payload, &done) != 0) {
+            free(payload);
+            break;
+        }
+        free(payload);
+    }
+
+    remote_close_conn(&conn);
+    return NULL;
+}
+
+struct listener_arg {
+    struct server_state *srv;
+    int listen_fd;
+    bool is_rdma;
+};
+
+static void *accept_loop(void *arg)
+{
+    struct listener_arg *la = (struct listener_arg *)arg;
+
+    for (;;) {
+        struct remote_conn conn;
+        struct client_arg *ca;
+        pthread_t tid;
+
+        if (remote_accept_conn(la->listen_fd, la->is_rdma, &conn) != 0) {
+            continue;
+        }
+
+        ca = malloc(sizeof(*ca));
+        if (!ca) {
+            remote_close_conn(&conn);
+            continue;
+        }
+        ca->srv = la->srv;
+        ca->conn = conn;
+
+        if (pthread_create(&tid, NULL, client_thread, ca) == 0) {
+            pthread_detach(tid);
+        } else {
+            remote_close_conn(&ca->conn);
+            free(ca);
+        }
+    }
+    return NULL;
+}
+
+static void print_usage(const char *prog)
+{
+    fprintf(stderr,
+            "Usage: %s [-l host:port] [-d devstr] [--sim]\n"
+            "  -l host:port   Listen address (default 0.0.0.0:5555; RDMA uses port+1 if active)\n"
+            "  -d devstr      Local bladeRF identifier (default libusb:)\n"
+            "  --sim          Run simulated bladeRF2 xA4 device without hardware\n",
+            prog);
+}
+
+int main(int argc, char **argv)
+{
+    const char *listen_addr = "0.0.0.0:5555";
+    const char *devstr = "libusb:";
+    bool sim = false;
+    char host[BLADERF_ADDR_LENGTH];
+    uint16_t port = REMOTE_DEFAULT_PORT;
+    struct server_state srv;
+    int tcp_fd;
+    int rdma_fd;
+    int i;
+
+    signal(SIGPIPE, SIG_IGN);
+
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-l") == 0 && i + 1 < argc) {
+            listen_addr = argv[++i];
+        } else if (strcmp(argv[i], "-d") == 0 && i + 1 < argc) {
+            devstr = argv[++i];
+        } else if (strcmp(argv[i], "--sim") == 0) {
+            sim = true;
+        } else {
+            print_usage(argv[0]);
+            return 1;
+        }
+    }
+
+    if (remote_parse_addr(listen_addr, host, sizeof(host), &port) != 0) {
+        fprintf(stderr, "Invalid listen address: %s\n", listen_addr);
+        return 1;
+    }
+
+    memset(&srv, 0, sizeof(srv));
+    srv.sim = sim;
+    pthread_mutex_init(&srv.dev_lock, NULL);
+
+    if (sim) {
+        init_sim_state(&srv.sim_dev);
+        fprintf(stderr, "bladerf-remote: simulated bladeRF 2.0 xA4 ready\n");
+    } else {
+        int status = bladerf_open(&srv.dev, devstr);
+        if (status != 0) {
+            fprintf(stderr, "bladerf_open(%s) failed: %s\n",
+                    devstr, bladerf_strerror(status));
+            return 1;
+        }
+        fprintf(stderr, "bladerf-remote: opened device (%s)\n",
+                bladerf_get_board_name(srv.dev));
+    }
+
+    rdma_fd = remote_listen_rdma(host, (uint16_t)(port + 1u));
+    if (rdma_fd >= 0) {
+        static struct listener_arg rdma_arg;
+        pthread_t rdma_tid;
+        rdma_arg.srv = &srv;
+        rdma_arg.listen_fd = rdma_fd;
+        rdma_arg.is_rdma = true;
+        if (pthread_create(&rdma_tid, NULL, accept_loop, &rdma_arg) == 0) {
+            pthread_detach(rdma_tid);
+            fprintf(stderr, "bladerf-remote: listening RDMA (librdmacm) on %s:%u\n",
+                    host, (unsigned int)(port + 1u));
+        } else {
+            struct remote_conn tmp_conn = { rdma_fd, true };
+            remote_close_conn(&tmp_conn);
+            rdma_fd = -1;
+        }
+    } else {
+        fprintf(stderr, "bladerf-remote: RDMA unavailable, serving TCP fallback on %s:%u\n",
+                host, (unsigned int)port);
+    }
+
+    tcp_fd = remote_listen_tcp(host, port);
+    if (tcp_fd < 0) {
+        fprintf(stderr, "Failed to listen on TCP %s:%u\n", host, (unsigned int)port);
+        if (rdma_fd >= 0) {
+            struct remote_conn tmp_conn = { rdma_fd, true };
+            remote_close_conn(&tmp_conn);
+        }
+        if (srv.dev) {
+            bladerf_close(srv.dev);
+        }
+        return 1;
+    }
+    fprintf(stderr, "bladerf-remote: listening TCP on %s:%u\n", host, (unsigned int)port);
+
+    {
+        struct listener_arg tcp_arg;
+        tcp_arg.srv = &srv;
+        tcp_arg.listen_fd = tcp_fd;
+        tcp_arg.is_rdma = false;
+        accept_loop(&tcp_arg);
+    }
+
+    if (srv.dev) {
+        bladerf_close(srv.dev);
+    }
+    return 0;
+}
