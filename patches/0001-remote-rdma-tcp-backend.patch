+        FIELD_INIT(.set_vctcxo_tamer_mode, remote_set_vctcxo_tamer_mode), \
+        FIELD_INIT(.get_vctcxo_tamer_mode, remote_get_vctcxo_tamer_mode), \
+        FIELD_INIT(.get_vctcxo_trim, remote_get_vctcxo_trim),  \
+        FIELD_INIT(.trim_dac_read, remote_trim_dac_read),      \
+        FIELD_INIT(.trim_dac_write, remote_trim_dac_write),    \
+        FIELD_INIT(.read_trigger, remote_read_trigger),        \
+        FIELD_INIT(.write_trigger, remote_write_trigger),      \
+        FIELD_INIT(.wishbone_master_read, remote_wishbone_master_read), \
+        FIELD_INIT(.wishbone_master_write, remote_wishbone_master_write), \
+        FIELD_INIT(.config_gpio_read, remote_config_gpio_read), \
+        FIELD_INIT(.config_gpio_write, remote_config_gpio_write), \
+        FIELD_INIT(.erase_flash, remote_erase_flash),          \
