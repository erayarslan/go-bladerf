+static int remote_sync_tx(struct bladerf *dev,
+                          const void *samples,
+                          unsigned int num_samples,
+                          struct bladerf_metadata *metadata,
+                          unsigned int timeout_ms)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    struct remote_board_data *bd = dev->board_data;
+    struct remote_sync_io_req req;
+    struct remote_sync_io_resp resp;
+    struct remote_msg_hdr req_hdr;
+    struct remote_msg_hdr resp_hdr;
+    size_t byte_len;
+    int status;
+
+    if (!samples && num_samples > 0) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    byte_len = samples_to_bytes(bd->sync_format[1], num_samples);
+    if (byte_len > REMOTE_MAX_PAYLOAD) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    memset(&req, 0, sizeof(req));
+    req.num_samples = (uint32_t)num_samples;
+    req.timeout_ms = (uint32_t)timeout_ms;
+    if (metadata != NULL) {
+        req.has_meta = 1;
+        req.timestamp = metadata->timestamp;
+        req.flags = metadata->flags;
+    }
+    req.byte_len = (uint32_t)byte_len;
+
+    memset(&req_hdr, 0, sizeof(req_hdr));
+    req_hdr.magic = REMOTE_PROTO_MAGIC;
+    req_hdr.opcode = REMOTE_OP_SYNC_TX;
+    req_hdr.payload_len = (uint32_t)(sizeof(req) + byte_len);
+
+    pthread_mutex_lock(&ctx->ctrl_lock);
+    status = remote_send_all(&ctx->ctrl, &req_hdr, sizeof(req_hdr));
+    if (status == 0) {
+        status = remote_send_all(&ctx->ctrl, &req, sizeof(req));
+    }
+    if (status == 0 && byte_len > 0) {
+        status = remote_send_all(&ctx->ctrl, samples, byte_len);
+    }
+    if (status != 0) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return status;
+    }
+
+    status = remote_recv_all(&ctx->ctrl, &resp_hdr, sizeof(resp_hdr));
+    if (status != 0) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return status;
+    }
+    if (resp_hdr.magic != REMOTE_PROTO_MAGIC ||
+        resp_hdr.opcode != REMOTE_OP_SYNC_TX ||
+        resp_hdr.payload_len > sizeof(resp)) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return BLADERF_ERR_UNEXPECTED;
+    }
+    if (resp_hdr.payload_len > 0) {
+        status = remote_recv_all(&ctx->ctrl, &resp, resp_hdr.payload_len);
+        if (status != 0) {
+            pthread_mutex_unlock(&ctx->ctrl_lock);
+            return status;
+        }
+        if (metadata != NULL && resp_hdr.payload_len == sizeof(resp)) {
+            metadata->timestamp = resp.timestamp;
+            metadata->flags = resp.flags;
+            metadata->status = resp.status;
+            metadata->actual_count = resp.actual_count;
+        }
+    }
+    pthread_mutex_unlock(&ctx->ctrl_lock);
+    return resp_hdr.status;
+}
+
+static int remote_sync_rx(struct bladerf *dev,
+                          void *samples,
+                          unsigned int num_samples,
+                          struct bladerf_metadata *metadata,
+                          unsigned int timeout_ms)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    struct remote_board_data *bd = dev->board_data;
+    struct remote_sync_io_req req;
+    struct remote_sync_io_resp resp;
+    struct remote_msg_hdr req_hdr;
+    struct remote_msg_hdr resp_hdr;
+    size_t max_bytes;
+    int status;
+
+    if (!samples && num_samples > 0) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    max_bytes = samples_to_bytes(bd->sync_format[0], num_samples);
+
+    memset(&req, 0, sizeof(req));
+    req.num_samples = (uint32_t)num_samples;
+    req.timeout_ms = (uint32_t)timeout_ms;
+    if (metadata != NULL) {
+        req.has_meta = 1;
+        req.timestamp = metadata->timestamp;
+        req.flags = metadata->flags;
+    }
+    req.byte_len = (uint32_t)max_bytes;
+
+    memset(&req_hdr, 0, sizeof(req_hdr));
+    req_hdr.magic = REMOTE_PROTO_MAGIC;
+    req_hdr.opcode = REMOTE_OP_SYNC_RX;
+    req_hdr.payload_len = sizeof(req);
+
+    pthread_mutex_lock(&ctx->ctrl_lock);
+    status = remote_send_all(&ctx->ctrl, &req_hdr, sizeof(req_hdr));
+    if (status == 0) {
+        status = remote_send_all(&ctx->ctrl, &req, sizeof(req));
+    }
+    if (status != 0) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return status;
+    }
+
+    status = remote_recv_all(&ctx->ctrl, &resp_hdr, sizeof(resp_hdr));
+    if (status != 0) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return status;
+    }
+    if (resp_hdr.magic != REMOTE_PROTO_MAGIC ||
+        resp_hdr.opcode != REMOTE_OP_SYNC_RX ||
+        resp_hdr.payload_len < sizeof(resp) ||
+        resp_hdr.payload_len > sizeof(resp) + max_bytes) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return BLADERF_ERR_UNEXPECTED;
+    }
+
+    status = remote_recv_all(&ctx->ctrl, &resp, sizeof(resp));
+    if (status != 0) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return status;
+    }
+
+    if (resp.byte_len > max_bytes ||
+        sizeof(resp) + resp.byte_len != resp_hdr.payload_len) {
+        pthread_mutex_unlock(&ctx->ctrl_lock);
+        return BLADERF_ERR_UNEXPECTED;
+    }
+    if (resp.byte_len > 0) {
+        status = remote_recv_all(&ctx->ctrl, samples, resp.byte_len);
+        if (status != 0) {
+            pthread_mutex_unlock(&ctx->ctrl_lock);
+            return status;
+        }
+    }
+    pthread_mutex_unlock(&ctx->ctrl_lock);
+
+    if (metadata != NULL) {
+        metadata->timestamp = resp.timestamp;
+        metadata->flags = resp.flags;
+        metadata->status = resp.status;
+        metadata->actual_count = resp.actual_count;
+    }
+    return resp_hdr.status;
+}
