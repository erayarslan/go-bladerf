+
+int remote_parse_addr(const char *addr_str,
+                      char *host_out,
+                      size_t host_len,
+                      uint16_t *port_out)
+{
+    const char *p = addr_str;
+    const char *colon;
+    char port_buf[16];
+    long port_val;
+    char *endptr = NULL;
+    size_t copy_len;
+
+    if (!addr_str || !addr_str[0] || !host_out || host_len == 0 || !port_out) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    if (strncmp(p, "rdma://", 7) == 0) {
+        p += 7;
+    } else if (strncmp(p, "tcp://", 6) == 0) {
+        p += 6;
+    }
+
+    if (!p[0]) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    colon = strrchr(p, ':');
+    if (colon != NULL && colon[1] != '\0') {
+        copy_len = (size_t)(colon - p);
+        if (copy_len == 0 || copy_len >= host_len) {
+            return BLADERF_ERR_INVAL;
+        }
+        memcpy(host_out, p, copy_len);
+        host_out[copy_len] = '\0';
+
+        if (strlen(colon + 1) >= sizeof(port_buf)) {
+            return BLADERF_ERR_INVAL;
+        }
+        strcpy(port_buf, colon + 1);
+        port_val = strtol(port_buf, &endptr, 10);
+        if (*endptr != '\0' || port_val <= 0 || port_val >= 65535) {
+            return BLADERF_ERR_INVAL;
+        }
+        *port_out = (uint16_t)port_val;
+    } else {
+        copy_len = strlen(p);
+        if (copy_len >= host_len) {
+            return BLADERF_ERR_INVAL;
+        }
+        strcpy(host_out, p);
+        *port_out = REMOTE_DEFAULT_PORT;
+    }
+
+    return 0;
+}
+
+#ifdef HAVE_RDMA
+struct rdma_dyn_api {
+    void *ibv_handle;
+    void *rdma_handle;
+    bool ready;
+    void **(*ibv_get_device_list)(int *num_devices);
+    void (*ibv_free_device_list)(void **list);
+    int (*rsocket)(int domain, int type, int protocol);
+    int (*rsetsockopt)(int socket, int level, int option_name, const void *option_value, socklen_t option_len);
+    int (*rconnect)(int socket, const struct sockaddr *address, socklen_t address_len);
+    int (*rbind)(int socket, const struct sockaddr *address, socklen_t address_len);
+    int (*rlisten)(int socket, int backlog);
+    int (*raccept)(int socket, struct sockaddr *address, socklen_t *address_len);
+    ssize_t (*rsend)(int socket, const void *buf, size_t len, int flags);
+    ssize_t (*rrecv)(int socket, void *buf, size_t len, int flags);
+    int (*rshutdown)(int socket, int how);
+    int (*rclose)(int fd);
+};
+
+static struct rdma_dyn_api g_rdma;
+static pthread_once_t g_rdma_once = PTHREAD_ONCE_INIT;
+
+static void *rdma_load_symbol(void *handle, const char *name, const char *ver)
+{
+    void *sym = NULL;
+#if defined(__GLIBC__)
+    if (ver != NULL) {
+        sym = dlvsym(handle, name, ver);
+    }
+#else
+    (void)ver;
+#endif
+    if (sym == NULL) {
+        sym = dlsym(handle, name);
+    }
+    return sym;
+}
+
+static void rdma_dyn_init(void)
+{
+    void *sym;
+
+    g_rdma.ibv_handle = dlopen("libibverbs.so.1", RTLD_LAZY | RTLD_GLOBAL);
+    if (!g_rdma.ibv_handle) {
+        g_rdma.ibv_handle = dlopen("libibverbs.so", RTLD_LAZY | RTLD_GLOBAL);
+    }
+    if (!g_rdma.ibv_handle) {
+        return;
+    }
+
+    g_rdma.rdma_handle = dlopen("librdmacm.so.1", RTLD_LAZY | RTLD_LOCAL);
+    if (!g_rdma.rdma_handle) {
+        g_rdma.rdma_handle = dlopen("librdmacm.so", RTLD_LAZY | RTLD_LOCAL);
+    }
+    if (!g_rdma.rdma_handle) {
+        dlclose(g_rdma.ibv_handle);
+        g_rdma.ibv_handle = NULL;
+        return;
+    }
+
+#define RDMA_BIND_SYM(handle, field, name, ver)                    \
+    do {                                                           \
+        sym = rdma_load_symbol((handle), (name), (ver));           \
+        if (!sym) {                                                \
+            dlclose(g_rdma.rdma_handle);                           \
+            dlclose(g_rdma.ibv_handle);                            \
+            memset(&g_rdma, 0, sizeof(g_rdma));                    \
+            return;                                                \
+        }                                                          \
+        memcpy(&g_rdma.field, &sym, sizeof(sym));                  \
+    } while (0)
+
+    RDMA_BIND_SYM(g_rdma.ibv_handle, ibv_get_device_list, "ibv_get_device_list", "IBVERBS_1.1");
+    RDMA_BIND_SYM(g_rdma.ibv_handle, ibv_free_device_list, "ibv_free_device_list", "IBVERBS_1.1");
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rsocket, "rsocket", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rsetsockopt, "rsetsockopt", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rconnect, "rconnect", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rbind, "rbind", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rlisten, "rlisten", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, raccept, "raccept", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rsend, "rsend", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rrecv, "rrecv", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rshutdown, "rshutdown", NULL);
+    RDMA_BIND_SYM(g_rdma.rdma_handle, rclose, "rclose", NULL);
+
+#undef RDMA_BIND_SYM
+    g_rdma.ready = true;
+}
+
+static bool rdma_dyn_ready(void)
+{
+    pthread_once(&g_rdma_once, rdma_dyn_init);
+    return g_rdma.ready;
+}
+#endif
+
+bool remote_rdma_devices_present(void)
+{
+#ifdef HAVE_RDMA
+    int num_devices = 0;
+    void **list;
+    if (!rdma_dyn_ready()) {
+        return false;
+    }
+    list = g_rdma.ibv_get_device_list(&num_devices);
+    if (list != NULL) {
+        g_rdma.ibv_free_device_list(list);
+    }
+    return num_devices > 0;
+#else
+    return false;
+#endif
+}
+
+static void configure_tcp_socket(int fd)
+{
+    int one = 1;
+    int buf_sz = 4 * 1024 * 1024;
+    (void)setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    (void)setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &buf_sz, sizeof(buf_sz));
+    (void)setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &buf_sz, sizeof(buf_sz));
+}
+
+static int connect_tcp_socket(const char *host, uint16_t port)
+{
+    struct addrinfo hints;
+    struct addrinfo *res = NULL;
+    struct addrinfo *it;
+    char port_str[16];
+    int fd = -1;
+    int gai_err;
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+
+    snprintf(port_str, sizeof(port_str), "%u", (unsigned int)port);
+    gai_err = getaddrinfo(host, port_str, &hints, &res);
+    if (gai_err != 0 || !res) {
+        REMOTE_LOG_DEBUG("getaddrinfo(%s:%s) failed: %s\n",
+                         host, port_str, gai_strerror(gai_err));
+        return -1;
+    }
+
+    for (it = res; it != NULL; it = it->ai_next) {
+        fd = socket(it->ai_family, it->ai_socktype, it->ai_protocol);
+        if (fd < 0) {
+            continue;
+        }
+        if (connect(fd, it->ai_addr, it->ai_addrlen) == 0) {
+            configure_tcp_socket(fd);
+            break;
+        }
+        close(fd);
+        fd = -1;
+    }
+
+    freeaddrinfo(res);
+    return fd;
+}
+
+#ifdef HAVE_RDMA
+static void configure_rdma_socket(int fd)
+{
+    int one = 1;
+    int buf_sz = 4 * 1024 * 1024;
+    (void)g_rdma.rsetsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    (void)g_rdma.rsetsockopt(fd, SOL_SOCKET, SO_RCVBUF, &buf_sz, sizeof(buf_sz));
+    (void)g_rdma.rsetsockopt(fd, SOL_SOCKET, SO_SNDBUF, &buf_sz, sizeof(buf_sz));
+}
+
+static int connect_rdma_socket(const char *host, uint16_t rdma_port)
+{
+    struct addrinfo hints;
+    struct addrinfo *res = NULL;
+    struct addrinfo *it;
+    char port_str[16];
+    int fd = -1;
+    int gai_err;
+
+    if (!rdma_dyn_ready()) {
+        return -1;
+    }
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+
+    snprintf(port_str, sizeof(port_str), "%u", (unsigned int)rdma_port);
+    gai_err = getaddrinfo(host, port_str, &hints, &res);
+    if (gai_err != 0 || !res) {
+        return -1;
+    }
+
+    for (it = res; it != NULL; it = it->ai_next) {
+        fd = g_rdma.rsocket(it->ai_family, it->ai_socktype, it->ai_protocol);
+        if (fd < 0) {
+            continue;
+        }
+        if (g_rdma.rconnect(fd, it->ai_addr, it->ai_addrlen) == 0) {
+            configure_rdma_socket(fd);
+            break;
+        }
+        g_rdma.rclose(fd);
+        fd = -1;
+    }
+
+    freeaddrinfo(res);
+    return fd;
+}
+#endif
+
+int remote_connect(const char *host,
+                   uint16_t port,
+                   bool prefer_rdma,
+                   struct remote_conn *out)
+{
+    int fd = -1;
+
+    if (!host || !host[0] || !out) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    out->fd = -1;
+    out->is_rdma = false;
+
+    if (prefer_rdma) {
+#ifdef HAVE_RDMA
+        if (remote_rdma_devices_present()) {
+            uint16_t rdma_port = (uint16_t)(port + 1u);
+            fd = connect_rdma_socket(host, rdma_port);
+            if (fd >= 0) {
+                out->fd = fd;
+                out->is_rdma = true;
+                REMOTE_LOG_INFO("Connected via RDMA (librdmacm) to %s:%u\n",
+                                host, (unsigned int)rdma_port);
+                return 0;
+            }
+            REMOTE_LOG_INFO("RDMA connect to %s:%u failed (%s), falling back to TCP %s:%u\n",
+                            host, (unsigned int)rdma_port, strerror(errno),
+                            host, (unsigned int)port);
+        } else {
+            REMOTE_LOG_INFO("No RDMA verbs hardware/provider present, falling back to TCP %s:%u\n",
+                            host, (unsigned int)port);
+        }
+#else
+        REMOTE_LOG_INFO("RDMA not compiled on this platform, falling back to TCP %s:%u\n",
+                        host, (unsigned int)port);
+#endif
+    }
+
+    fd = connect_tcp_socket(host, port);
+    if (fd < 0) {
+        return BLADERF_ERR_NODEV;
+    }
+
+    out->fd = fd;
+    out->is_rdma = false;
+    REMOTE_LOG_DEBUG("Connected via TCP to %s:%u\n", host, (unsigned int)port);
+    return 0;
+}
+
+void remote_close_conn(struct remote_conn *conn)
+{
+    if (!conn || conn->fd < 0) {
+        return;
+    }
+
+#ifdef HAVE_RDMA
+    if (conn->is_rdma && rdma_dyn_ready()) {
+        g_rdma.rshutdown(conn->fd, SHUT_RDWR);
+        g_rdma.rclose(conn->fd);
+        conn->fd = -1;
+        conn->is_rdma = false;
+        return;
+    }
+#endif
+    shutdown(conn->fd, SHUT_RDWR);
+    close(conn->fd);
+    conn->fd = -1;
+    conn->is_rdma = false;
+}
+
+int remote_send_all(const struct remote_conn *conn,
+                    const void *buf,
+                    size_t len)
+{
+    const uint8_t *p = (const uint8_t *)buf;
+    size_t sent = 0;
+
+    if (!conn || conn->fd < 0) {
+        return BLADERF_ERR_IO;
+    }
+
+    while (sent < len) {
+        ssize_t n;
+#ifdef HAVE_RDMA
+        if (conn->is_rdma && rdma_dyn_ready()) {
+            n = g_rdma.rsend(conn->fd, p + sent, len - sent, 0);
+        } else {
+            n = send(conn->fd, p + sent, len - sent, REMOTE_SEND_FLAGS);
+        }
+#else
+        n = send(conn->fd, p + sent, len - sent, REMOTE_SEND_FLAGS);
+#endif
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return BLADERF_ERR_IO;
+        }
+        if (n == 0) {
+            return BLADERF_ERR_IO;
+        }
+        sent += (size_t)n;
+    }
+
+    return 0;
+}
+
+int remote_recv_all(const struct remote_conn *conn,
+                    void *buf,
+                    size_t len)
+{
+    uint8_t *p = (uint8_t *)buf;
+    size_t recvd = 0;
+
+    if (!conn || conn->fd < 0) {
+        return BLADERF_ERR_IO;
+    }
+
+    while (recvd < len) {
+        ssize_t n;
+#ifdef HAVE_RDMA
+        if (conn->is_rdma && rdma_dyn_ready()) {
+            n = g_rdma.rrecv(conn->fd, p + recvd, len - recvd, 0);
+        } else {
+            n = recv(conn->fd, p + recvd, len - recvd, 0);
+        }
+#else
+        n = recv(conn->fd, p + recvd, len - recvd, 0);
+#endif
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return BLADERF_ERR_IO;
+        }
+        if (n == 0) {
+            return BLADERF_ERR_IO;
+        }
+        recvd += (size_t)n;
+    }
+
+    return 0;
+}
+
+static int drain_bytes(const struct remote_conn *conn, size_t len)
+{
+    uint8_t discard[1024];
+    while (len > 0) {
+        size_t chunk = len > sizeof(discard) ? sizeof(discard) : len;
+        int status = remote_recv_all(conn, discard, chunk);
+        if (status != 0) {
+            return status;
+        }
+        len -= chunk;
+    }
+    return 0;
+}
+
+int remote_rpc(const struct remote_conn *conn,
+               pthread_mutex_t *lock,
+               uint16_t opcode,
+               const void *req,
+               uint32_t req_len,
+               void *resp,
+               uint32_t resp_cap,
+               uint32_t *resp_len_out)
+{
+    struct remote_msg_hdr req_hdr;
+    struct remote_msg_hdr resp_hdr;
+    int status;
+
+    if (!conn || conn->fd < 0) {
+        return BLADERF_ERR_IO;
+    }
+
+    memset(&req_hdr, 0, sizeof(req_hdr));
+    req_hdr.magic = REMOTE_PROTO_MAGIC;
+    req_hdr.opcode = opcode;
+    req_hdr.flags = 0;
+    req_hdr.status = 0;
+    req_hdr.payload_len = req_len;
+
+    if (lock) {
+        pthread_mutex_lock(lock);
+    }
+
+    status = remote_send_all(conn, &req_hdr, sizeof(req_hdr));
+    if (status == 0 && req_len > 0 && req != NULL) {
+        status = remote_send_all(conn, req, req_len);
+    }
+    if (status != 0) {
+        goto out;
+    }
+
+    status = remote_recv_all(conn, &resp_hdr, sizeof(resp_hdr));
+    if (status != 0) {
+        goto out;
+    }
+
+    if (resp_hdr.magic != REMOTE_PROTO_MAGIC || resp_hdr.opcode != opcode ||
+        resp_hdr.payload_len > REMOTE_MAX_PAYLOAD) {
+        status = BLADERF_ERR_UNEXPECTED;
+        goto out;
+    }
+
+    if (resp_hdr.payload_len > 0) {
+        if (resp != NULL && resp_hdr.payload_len <= resp_cap) {
+            status = remote_recv_all(conn, resp, resp_hdr.payload_len);
+            if (status != 0) {
+                goto out;
+            }
+        } else {
+            uint32_t to_read = (resp != NULL) ? resp_cap : 0;
+            if (to_read > 0) {
+                status = remote_recv_all(conn, resp, to_read);
+                if (status != 0) {
+                    goto out;
+                }
+            }
+            status = drain_bytes(conn, resp_hdr.payload_len - to_read);
+            if (status != 0) {
+                goto out;
+            }
+            if (resp_hdr.status == 0 && resp != NULL) {
+                status = BLADERF_ERR_UNEXPECTED;
+                goto out;
+            }
+        }
+    }
+
+    if (resp_len_out != NULL) {
+        *resp_len_out = resp_hdr.payload_len;
+    }
+    status = resp_hdr.status;
+
+out:
+    if (lock) {
+        pthread_mutex_unlock(lock);
+    }
+    return status;
+}
+
+int remote_listen_tcp(const char *host, uint16_t port)
+{
+    struct addrinfo hints;
+    struct addrinfo *res = NULL;
+    struct addrinfo *it;
+    char port_str[16];
+    int fd = -1;
+    int one = 1;
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_PASSIVE;
+
+    snprintf(port_str, sizeof(port_str), "%u", (unsigned int)port);
+    if (getaddrinfo(host && host[0] ? host : NULL, port_str, &hints, &res) != 0) {
+        return -1;
+    }
+
+    for (it = res; it != NULL; it = it->ai_next) {
+        fd = socket(it->ai_family, it->ai_socktype, it->ai_protocol);
+        if (fd < 0) {
+            continue;
+        }
+        (void)setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+        if (bind(fd, it->ai_addr, it->ai_addrlen) == 0 && listen(fd, 16) == 0) {
+            break;
+        }
+        close(fd);
+        fd = -1;
+    }
+
+    freeaddrinfo(res);
+    return fd;
+}
+
+int remote_listen_rdma(const char *host, uint16_t port)
+{
+#ifdef HAVE_RDMA
+    struct addrinfo hints;
+    struct addrinfo *res = NULL;
+    struct addrinfo *it;
+    char port_str[16];
+    int fd = -1;
+    int one = 1;
+
+    if (!remote_rdma_devices_present()) {
+        return -1;
+    }
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_PASSIVE;
+
+    snprintf(port_str, sizeof(port_str), "%u", (unsigned int)port);
+    if (getaddrinfo(host && host[0] ? host : NULL, port_str, &hints, &res) != 0) {
+        return -1;
+    }
+
+    for (it = res; it != NULL; it = it->ai_next) {
+        fd = g_rdma.rsocket(it->ai_family, it->ai_socktype, it->ai_protocol);
+        if (fd < 0) {
+            continue;
+        }
+        (void)g_rdma.rsetsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+        if (g_rdma.rbind(fd, it->ai_addr, it->ai_addrlen) == 0 && g_rdma.rlisten(fd, 16) == 0) {
+            break;
+        }
+        g_rdma.rclose(fd);
+        fd = -1;
+    }
+
+    freeaddrinfo(res);
+    return fd;
+#else
+    (void)host;
+    (void)port;
+    return -1;
+#endif
+}
+
+int remote_accept_conn(int listen_fd, bool is_rdma, struct remote_conn *out)
+{
+    struct sockaddr_storage ss;
+    socklen_t slen = sizeof(ss);
+    int fd;
+
+    if (listen_fd < 0 || !out) {
+        return -1;
+    }
+
+#ifdef HAVE_RDMA
+    if (is_rdma) {
+        if (!rdma_dyn_ready()) {
+            return -1;
+        }
+        fd = g_rdma.raccept(listen_fd, (struct sockaddr *)&ss, &slen);
+        if (fd < 0) {
+            return -1;
+        }
+        configure_rdma_socket(fd);
+        out->fd = fd;
+        out->is_rdma = true;
+        return 0;
+    }
+#endif
+    (void)is_rdma;
+    fd = accept(listen_fd, (struct sockaddr *)&ss, &slen);
+    if (fd < 0) {
+        return -1;
+    }
+    configure_tcp_socket(fd);
+    out->fd = fd;
+    out->is_rdma = false;
+    return 0;
+}
