diff --git a/host/libraries/libbladeRF/src/backend/remote/remote_backend.c b/host/libraries/libbladeRF/src/backend/remote/remote_backend.c
new file mode 100644
index 0000000..ff4d4bd
--- /dev/null
+++ b/host/libraries/libbladeRF/src/backend/remote/remote_backend.c
@@ -0,0 +1,423 @@
+#include <stdlib.h>
+#include <string.h>
+
+#include "backend/backend.h"
+#include "board/board.h"
+#include "devinfo.h"
+#include "log.h"
+
+#include "remote_backend.h"
+
+static bool remote_matches(bladerf_backend backend)
+{
+    return backend == BLADERF_BACKEND_RDMA || backend == BLADERF_BACKEND_TCP;
+}
+
+static const char *resolve_addr(const struct bladerf_devinfo *info)
+{
+    const char *env_addr;
+
+    if (info && info->addr[0] != '\0') {
+        return info->addr;
+    }
+
+    env_addr = getenv("BLADERF_REMOTE_ADDR");
+    if (env_addr && env_addr[0] != '\0') {
+        return env_addr;
+    }
+
+    return NULL;
+}
+
+static void fill_devinfo_from_hello(struct bladerf_devinfo *dst,
+                                    const struct remote_hello_resp *hello,
+                                    bladerf_backend backend,
+                                    const char *addr_str)
+{
+    bladerf_init_devinfo(dst);
+    dst->backend = backend;
+    dst->usb_bus = 0;
+    dst->usb_addr = 0;
+    dst->instance = 0;
+
+    strncpy(dst->serial, hello->serial, sizeof(dst->serial) - 1);
+    dst->serial[sizeof(dst->serial) - 1] = '\0';
+
+    strncpy(dst->manufacturer, hello->manufacturer, sizeof(dst->manufacturer) - 1);
+    dst->manufacturer[sizeof(dst->manufacturer) - 1] = '\0';
+
+    strncpy(dst->product, hello->product, sizeof(dst->product) - 1);
+    dst->product[sizeof(dst->product) - 1] = '\0';
+
+    if (addr_str) {
+        strncpy(dst->addr, addr_str, sizeof(dst->addr) - 1);
+        dst->addr[sizeof(dst->addr) - 1] = '\0';
+    }
+}
+
+static int remote_probe(backend_probe_target probe_target,
+                        struct bladerf_devinfo_list *info_list)
+{
+    const char *env_addr;
+    char host[BLADERF_ADDR_LENGTH];
+    uint16_t port = REMOTE_DEFAULT_PORT;
+    struct remote_conn conn;
+    struct remote_hello_resp hello;
+    struct bladerf_devinfo info;
+    uint32_t resp_len = 0;
+    int status;
+    bool is_rdma;
+
+    if (probe_target != BACKEND_PROBE_BLADERF) {
+        return 0;
+    }
+
+    env_addr = getenv("BLADERF_REMOTE_ADDR");
+    if (!env_addr || !env_addr[0]) {
+        return 0;
+    }
+
+    status = remote_parse_addr(env_addr, host, sizeof(host), &port);
+    if (status != 0) {
+        return status;
+    }
+
+    status = remote_connect(host, port, strncmp(env_addr, "tcp://", 6) != 0, &conn);
+    if (status != 0) {
+        return BLADERF_ERR_NODEV;
+    }
+    is_rdma = conn.is_rdma;
+
+    memset(&hello, 0, sizeof(hello));
+    status = remote_rpc(&conn, NULL, REMOTE_OP_HELLO, NULL, 0,
+                        &hello, sizeof(hello), &resp_len);
+    remote_close_conn(&conn);
+    if (status != 0 || resp_len != sizeof(hello)) {
+        return BLADERF_ERR_NODEV;
+    }
+
+    fill_devinfo_from_hello(&info, &hello,
+                            is_rdma ? BLADERF_BACKEND_RDMA : BLADERF_BACKEND_TCP,
+                            env_addr);
+    return bladerf_devinfo_list_add(info_list, &info);
+}
+
+static int remote_get_vid_pid(struct bladerf *dev, uint16_t *vid, uint16_t *pid)
+{
+    (void)dev;
+    (void)vid;
+    (void)pid;
+    return BLADERF_ERR_UNSUPPORTED;
+}
+
+static int remote_get_flash_id(struct bladerf *dev, uint8_t *mid, uint8_t *did)
+{
+    (void)dev;
+    (void)mid;
+    (void)did;
+    return BLADERF_ERR_UNSUPPORTED;
+}
+
+static int remote_open(struct bladerf *dev, struct bladerf_devinfo *info)
+{
+    const char *addr_str = resolve_addr(info);
+    struct remote_dev_ctx *ctx;
+    uint32_t resp_len = 0;
+    int status;
+
+    if (!addr_str) {
+        return BLADERF_ERR_NODEV;
+    }
+
+    ctx = calloc(1, sizeof(*ctx));
+    if (!ctx) {
+        return BLADERF_ERR_MEM;
+    }
+    ctx->ctrl.fd = -1;
+    pthread_mutex_init(&ctx->ctrl_lock, NULL);
+
+    status = remote_parse_addr(addr_str, ctx->host, sizeof(ctx->host), &ctx->port);
+    if (status != 0) {
+        pthread_mutex_destroy(&ctx->ctrl_lock);
+        free(ctx);
+        return status;
+    }
+
+    ctx->prefer_rdma = (info->backend != BLADERF_BACKEND_TCP);
+
+    status = remote_connect(ctx->host, ctx->port, ctx->prefer_rdma, &ctx->ctrl);
+    if (status != 0) {
+        pthread_mutex_destroy(&ctx->ctrl_lock);
+        free(ctx);
+        return status;
+    }
+
+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_HELLO,
+                        NULL, 0, &ctx->hello, sizeof(ctx->hello), &resp_len);
+    if (status != 0 || resp_len != sizeof(ctx->hello)) {
+        remote_close_conn(&ctx->ctrl);
+        pthread_mutex_destroy(&ctx->ctrl_lock);
+        free(ctx);
+        return status < 0 ? status : BLADERF_ERR_UNEXPECTED;
+    }
+
+    fill_devinfo_from_hello(&dev->ident, &ctx->hello,
+                            ctx->ctrl.is_rdma ? BLADERF_BACKEND_RDMA : BLADERF_BACKEND_TCP,
+                            addr_str);
+
+    if (info && !bladerf_serial_matches(info, &dev->ident)) {
+        remote_close_conn(&ctx->ctrl);
+        pthread_mutex_destroy(&ctx->ctrl_lock);
+        free(ctx);
+        return BLADERF_ERR_NODEV;
+    }
+
+    dev->backend = &backend_fns_remote;
+    dev->backend_data = ctx;
+    return 0;
+}
+
+static int remote_set_fpga_protocol(struct bladerf *dev,
+                                    backend_fpga_protocol fpga_protocol)
+{
+    (void)dev;
+    (void)fpga_protocol;
+    return 0;
+}
+
+static void remote_close(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+
+    if (ctx != NULL) {
+        remote_close_conn(&ctx->ctrl);
+        pthread_mutex_destroy(&ctx->ctrl_lock);
+        free(ctx);
+        dev->backend_data = NULL;
+    }
+}
+
+static int remote_is_fw_ready(struct bladerf *dev)
+{
+    (void)dev;
+    return 1;
+}
+
+static int remote_get_handle(struct bladerf *dev, void **handle)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    if (!handle) {
+        return BLADERF_ERR_INVAL;
+    }
+    *handle = ctx ? (void *)(intptr_t)ctx->ctrl.fd : NULL;
+    return 0;
+}
+
+static int remote_is_fpga_configured(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    return ctx ? ctx->hello.is_fpga_configured : 0;
+}
+
+static bladerf_fpga_source remote_get_fpga_source(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    return ctx ? (bladerf_fpga_source)ctx->hello.fpga_source
+               : BLADERF_FPGA_SOURCE_UNKNOWN;
+}
+
+static int remote_get_fw_version(struct bladerf *dev,
+                                 struct bladerf_version *version)
+{
+    return dev->board->get_fw_version(dev, version);
+}
+
+static int remote_get_fpga_version(struct bladerf *dev,
+                                   struct bladerf_version *version)
+{
+    return dev->board->get_fpga_version(dev, version);
+}
+
+static int remote_get_otp(struct bladerf *dev, char *otp)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    uint32_t resp_len = 0;
+    int status;
+
+    if (!ctx || !otp) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_READ_OTP,
+                        NULL, 0, otp, 256, &resp_len);
+    if (status == 0 && resp_len != 256) {
+        return BLADERF_ERR_UNEXPECTED;
+    }
+    return status;
+}
+
+static int remote_write_otp(struct bladerf *dev, char *otp)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+
+    if (!ctx || !otp) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    return remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_WRITE_OTP,
+                      otp, 256, NULL, 0, NULL);
+}
+
+static int remote_lock_otp(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+
+    if (!ctx) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    return remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_LOCK_OTP,
+                      NULL, 0, NULL, 0, NULL);
+}
+
+static int remote_get_device_speed(struct bladerf *dev,
+                                   bladerf_dev_speed *speed)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    if (!ctx || !speed) {
+        return BLADERF_ERR_INVAL;
+    }
+    *speed = (bladerf_dev_speed)ctx->hello.speed;
+    return 0;
+}
+
+static int remote_config_gpio_read(struct bladerf *dev, uint32_t *val)
+{
+    return dev->board->config_gpio_read(dev, val);
+}
+
+static int remote_config_gpio_write(struct bladerf *dev, uint32_t val)
+{
+    return dev->board->config_gpio_write(dev, val);
+}
+
+static int remote_erase_flash_blocks(struct bladerf *dev,
+                                     uint32_t eb,
+                                     uint16_t count)
+{
+    return dev->board->erase_flash(dev, eb, count);
+}
+
+static int remote_read_flash_pages(struct bladerf *dev,
+                                   uint8_t *buf,
+                                   uint32_t page,
+                                   uint32_t count)
+{
+    return dev->board->read_flash(dev, buf, page, count);
+}
+
+static int remote_write_flash_pages(struct bladerf *dev,
+                                    const uint8_t *buf,
+                                    uint32_t page,
+                                    uint32_t count)
+{
+    return dev->board->write_flash(dev, buf, page, count);
+}
+
+static int remote_read_fw_log(struct bladerf *dev, logger_entry *e)
+{
+    (void)dev;
+    *e = LOG_EOF;
+    return 0;
+}
+
+static int remote_load_fw_from_bootloader(bladerf_backend backend,
+                                            uint8_t bus,
+                                            uint8_t addr,
+                                            struct fx3_firmware *fw)
+{
+    (void)backend;
+    (void)bus;
+    (void)addr;
+    (void)fw;
+    return BLADERF_ERR_UNSUPPORTED;
+}
+
