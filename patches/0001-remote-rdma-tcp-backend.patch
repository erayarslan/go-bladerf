diff --git a/host/libraries/libbladeRF/src/board/remote/remote_board.c b/host/libraries/libbladeRF/src/board/remote/remote_board.c
new file mode 100644
index 0000000..f8857c2
--- /dev/null
+++ b/host/libraries/libbladeRF/src/board/remote/remote_board.c
@@ -0,0 +1,2042 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libbladeRF.h>
+
+#include "backend/remote/remote_backend.h"
+#include "board/board.h"
+#include "log.h"
+#include "streaming/async.h"
+#include "streaming/format.h"
+
+extern const struct backend_fns backend_fns_remote;
+
+struct remote_board_data {
+    char fw_version_str[33];
+    char fpga_version_str[33];
+
+    struct bladerf_range freq_range[4];
+    struct bladerf_range rate_range[4];
+    struct bladerf_range bw_range[4];
+    struct bladerf_range gain_range[4];
+
+    struct bladerf_range stage_range[4][REMOTE_MAX_LIST];
+    char stage_range_names[4][REMOTE_MAX_LIST][REMOTE_MAX_STR];
+    size_t num_stage_ranges[4];
+
+    struct bladerf_gain_modes gain_modes[4][REMOTE_MAX_MODES];
+    char gain_mode_names[4][REMOTE_MAX_MODES][REMOTE_MAX_STR];
+    int num_gain_modes[4];
+
+    struct bladerf_loopback_modes loopback_modes[REMOTE_MAX_MODES];
+    char loopback_mode_names[REMOTE_MAX_MODES][REMOTE_MAX_STR];
+    int num_loopback_modes;
+
+    char gain_stages[4][REMOTE_MAX_LIST][REMOTE_MAX_STR];
+    int num_gain_stages[4];
+
+    char rf_port_current[4][REMOTE_MAX_STR];
+    char rf_ports[4][REMOTE_MAX_LIST][REMOTE_MAX_STR];
+    int num_rf_ports[4];
+
+    bladerf_format sync_format[2];
+    uint32_t stream_num_transfers;
+    uint32_t stream_timeout_ms[2];
+};
+
+static size_t ch_to_idx(bladerf_channel ch)
+{
+    switch (ch) {
+        case BLADERF_CHANNEL_RX(0):
+            return 0;
+        case BLADERF_CHANNEL_TX(0):
+            return 1;
+        case BLADERF_CHANNEL_RX(1):
+            return 2;
+        case BLADERF_CHANNEL_TX(1):
+            return 3;
+        default:
+            return 0;
+    }
+}
+
+static size_t dir_to_idx(bladerf_direction dir)
+{
+    return (dir == BLADERF_TX) ? 1 : 0;
+}
+
+static bool remote_bladerf1_matches(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx;
+    if (!dev || dev->backend != &backend_fns_remote || !dev->backend_data) {
+        return false;
+    }
+    ctx = dev->backend_data;
+    return strcmp(ctx->hello.board_name, "bladerf1") == 0;
+}
+
+static bool remote_bladerf2_matches(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx;
+    if (!dev || dev->backend != &backend_fns_remote || !dev->backend_data) {
+        return false;
+    }
+    ctx = dev->backend_data;
+    return strcmp(ctx->hello.board_name, "bladerf1") != 0;
+}
+
+static int remote_board_open(struct bladerf *dev, struct bladerf_devinfo *devinfo)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    struct remote_board_data *bd;
+    uint32_t psize;
+    uint32_t ebsize;
+
+    (void)devinfo;
+
+    bd = calloc(1, sizeof(*bd));
+    if (!bd) {
+        return BLADERF_ERR_MEM;
+    }
+
+    snprintf(bd->fw_version_str, sizeof(bd->fw_version_str), "%.*s",
+             (int)(sizeof(bd->fw_version_str) - 1), ctx->hello.fw_describe);
+    snprintf(bd->fpga_version_str, sizeof(bd->fpga_version_str), "%.*s",
+             (int)(sizeof(bd->fpga_version_str) - 1), ctx->hello.fpga_describe);
+
+    bd->sync_format[0] = BLADERF_FORMAT_SC16_Q11;
+    bd->sync_format[1] = BLADERF_FORMAT_SC16_Q11;
+    bd->stream_num_transfers = 4;
+    bd->stream_timeout_ms[0] = 1000;
+    bd->stream_timeout_ms[1] = 1000;
+
+    dev->board_data = bd;
+
+    dev->flash_arch = calloc(1, sizeof(*dev->flash_arch));
+    if (!dev->flash_arch) {
+        free(bd);
+        dev->board_data = NULL;
+        return BLADERF_ERR_MEM;
+    }
+
+    psize = ctx->hello.flash_psize ? ctx->hello.flash_psize : 256u;
+    ebsize = ctx->hello.flash_ebsize ? ctx->hello.flash_ebsize : 65536u;
+
+    dev->flash_arch->status = STATUS_SUCCESS;
+    dev->flash_arch->tsize_bytes = ctx->hello.flash_size;
+    dev->flash_arch->psize_bytes = psize;
+    dev->flash_arch->ebsize_bytes = ebsize;
+    dev->flash_arch->num_pages = ctx->hello.flash_size / psize;
+    dev->flash_arch->num_ebs = ctx->hello.flash_size / ebsize;
+
+    return 0;
+}
+
+static void remote_board_close(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+
+    if (ctx && ctx->ctrl.fd >= 0) {
+        (void)remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_CLOSE,
+                         NULL, 0, NULL, 0, NULL);
+    }
+
+    free(dev->board_data);
+    dev->board_data = NULL;
+
+    free(dev->flash_arch);
+    dev->flash_arch = NULL;
+}
+
+static bladerf_dev_speed remote_device_speed(struct bladerf *dev)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    return ctx ? (bladerf_dev_speed)ctx->hello.speed : BLADERF_DEVICE_SPEED_UNKNOWN;
+}
+
+static int remote_get_serial(struct bladerf *dev, char *serial)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    if (!ctx || !serial) {
+        return BLADERF_ERR_INVAL;
+    }
+    strncpy(serial, ctx->hello.serial, BLADERF_SERIAL_LENGTH);
+    serial[BLADERF_SERIAL_LENGTH - 1] = '\0';
+    return 0;
+}
+
+static int remote_get_fpga_size(struct bladerf *dev, bladerf_fpga_size *size)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    if (!ctx || !size) {
+        return BLADERF_ERR_INVAL;
+    }
+    *size = (bladerf_fpga_size)ctx->hello.fpga_size;
+    return 0;
+}
+
+static int remote_get_fpga_bytes(struct bladerf *dev, size_t *size)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    if (!ctx || !size) {
+        return BLADERF_ERR_INVAL;
+    }
+    *size = (size_t)ctx->hello.fpga_bytes;
+    return 0;
+}
+
+static int remote_get_flash_size(struct bladerf *dev,
+                                 uint32_t *size,
+                                 bool *is_guess)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    if (!ctx || !size || !is_guess) {
+        return BLADERF_ERR_INVAL;
