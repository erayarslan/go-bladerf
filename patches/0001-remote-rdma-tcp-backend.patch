+static int remote_get_rf_ports(struct bladerf *dev,
+                               bladerf_channel ch,
+                               const char **ports,
+                               unsigned int count)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    struct remote_board_data *bd = dev->board_data;
+    size_t idx = ch_to_idx(ch);
+    struct remote_ch_req req = { (int32_t)ch };
+    struct remote_str_list_resp resp;
+    uint32_t resp_len = 0;
+    uint32_t i, n;
+    int status;
+
+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_GET_RF_PORTS,
+                        &req, sizeof(req), &resp, sizeof(resp), &resp_len);
+    if (status < 0) {
+        return status;
+    }
+    if (resp_len != sizeof(resp)) {
+        return BLADERF_ERR_UNEXPECTED;
+    }
+
+    n = resp.count > REMOTE_MAX_LIST ? REMOTE_MAX_LIST : resp.count;
+    for (i = 0; i < n; i++) {
+        strncpy(bd->rf_ports[idx][i], resp.items[i], REMOTE_MAX_STR - 1);
+        bd->rf_ports[idx][i][REMOTE_MAX_STR - 1] = '\0';
+    }
+    bd->num_rf_ports[idx] = (int)n;
+
+    if (ports != NULL && count > 0) {
+        unsigned int copy_n = n < count ? n : count;
+        for (i = 0; i < copy_n; i++) {
+            ports[i] = bd->rf_ports[idx][i];
+        }
+    }
+    return (int)n;
+}
