+static int remote_get_gain_stage_range(struct bladerf *dev,
+                                       bladerf_channel ch,
+                                       const char *stage,
+                                       struct bladerf_range const **range)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    struct remote_board_data *bd = dev->board_data;
+    size_t idx = ch_to_idx(ch);
+    struct remote_stage_req req;
+    struct remote_range_resp resp;
+    uint32_t resp_len = 0;
+    size_t slot = 0;
+    int status;
+
+    if (!stage || !range) {
+        return BLADERF_ERR_INVAL;
+    }
+
+    memset(&req, 0, sizeof(req));
+    req.ch = (int32_t)ch;
+    strncpy(req.stage, stage, sizeof(req.stage) - 1);
+
+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_GET_GAIN_STAGE_RANGE,
+                        &req, sizeof(req), &resp, sizeof(resp), &resp_len);
+    if (status != 0 || resp_len != sizeof(resp)) {
+        return status < 0 ? status : BLADERF_ERR_UNEXPECTED;
+    }
+
+    for (slot = 0; slot < bd->num_stage_ranges[idx]; slot++) {
+        if (strcmp(bd->stage_range_names[idx][slot], stage) == 0) {
+            break;
+        }
+    }
+    if (slot == bd->num_stage_ranges[idx]) {
+        if (slot >= REMOTE_MAX_LIST) {
+            slot = 0;
+        } else {
+            bd->num_stage_ranges[idx]++;
+        }
+        strncpy(bd->stage_range_names[idx][slot], stage, REMOTE_MAX_STR - 1);
+        bd->stage_range_names[idx][slot][REMOTE_MAX_STR - 1] = '\0';
+    }
+
+    bd->stage_range[idx][slot].min = resp.min;
+    bd->stage_range[idx][slot].max = resp.max;
+    bd->stage_range[idx][slot].step = resp.step;
+    bd->stage_range[idx][slot].scale = resp.scale;
+    *range = &bd->stage_range[idx][slot];
+    return 0;
+}
