+static int remote_get_loopback_modes(struct bladerf *dev,
+                                     const struct bladerf_loopback_modes **modes)
+{
+    struct remote_dev_ctx *ctx = dev->backend_data;
+    struct remote_board_data *bd = dev->board_data;
+    struct remote_mode_list_resp resp;
+    uint32_t resp_len = 0;
+    uint32_t i, count;
+    int status;
+
+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_GET_LOOPBACK_MODES,
+                        NULL, 0, &resp, sizeof(resp), &resp_len);
+    if (status < 0) {
+        return status;
+    }
+    if (resp_len != sizeof(resp)) {
+        return BLADERF_ERR_UNEXPECTED;
+    }
+
+    count = resp.count > REMOTE_MAX_MODES ? REMOTE_MAX_MODES : resp.count;
+    for (i = 0; i < count; i++) {
+        strncpy(bd->loopback_mode_names[i], resp.items[i].name, REMOTE_MAX_STR - 1);
+        bd->loopback_mode_names[i][REMOTE_MAX_STR - 1] = '\0';
+        bd->loopback_modes[i].name = bd->loopback_mode_names[i];
+        bd->loopback_modes[i].mode = (bladerf_loopback)resp.items[i].mode;
+    }
+    bd->num_loopback_modes = (int)count;
+
+    if (modes != NULL) {
+        *modes = (count > 0) ? bd->loopback_modes : NULL;
+    }
+    return (int)count;
+}
