+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_GET_GAIN_STAGES,
+                        &req, sizeof(req), &resp, sizeof(resp), &resp_len);
+    if (status < 0) {
+        return status;
+    }
+    if (resp_len != sizeof(resp)) {
+        return BLADERF_ERR_UNEXPECTED;
+    }
+
+    n = resp.count > REMOTE_MAX_LIST ? REMOTE_MAX_LIST : resp.count;
+    for (i = 0; i < n; i++) {
+        strncpy(bd->gain_stages[idx][i], resp.items[i], REMOTE_MAX_STR - 1);
+        bd->gain_stages[idx][i][REMOTE_MAX_STR - 1] = '\0';
+    }
+    bd->num_gain_stages[idx] = (int)n;
