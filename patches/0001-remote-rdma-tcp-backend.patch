diff --git a/host/utilities/bladeRF-remote/main.c b/host/utilities/bladeRF-remote/main.c
new file mode 100644
index 0000000..09650d0
--- /dev/null
+++ b/host/utilities/bladeRF-remote/main.c
@@ -0,0 +1,1913 @@
+#ifndef _POSIX_C_SOURCE
+#define _POSIX_C_SOURCE 200809L
+#endif
+
+#include <math.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <libbladeRF.h>
+
+#include "remote_proto.h"
+#include "remote_transport.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+struct sim_state {
+    uint64_t frequency[4];
+    uint32_t sample_rate[4];
+    uint32_t bandwidth[4];
+    int32_t gain[4];
+    int32_t gain_mode[4];
+    int32_t stage_gain[4];
+    int16_t corr[4][4];
+    bool enabled[4];
+    char rf_port[4][REMOTE_MAX_STR];
+    uint8_t trigger_reg[4];
+    int32_t rx_mux;
+    int32_t loopback;
+    int32_t tuning_mode;
+    uint32_t stream_timeout[2];
+    uint32_t config_gpio;
+    uint16_t trim_dac;
+    uint64_t timestamp[2];
+    double sim_phase;
+    uint8_t otp[256];
+    uint8_t flash_page_zero[256];
+    bool trig_armed;
+    bool trig_fired;
+    bool trig_fire_req;
+};
+
+struct server_state {
+    bool sim;
+    struct bladerf *dev;
+    pthread_mutex_t dev_lock;
+    struct sim_state sim_dev;
+};
+
+static size_t ch_idx(bladerf_channel ch)
+{
+    switch (ch) {
+        case BLADERF_CHANNEL_RX(0): return 0;
+        case BLADERF_CHANNEL_TX(0): return 1;
+        case BLADERF_CHANNEL_RX(1): return 2;
+        case BLADERF_CHANNEL_TX(1): return 3;
+        default: return 0;
+    }
+}
+
+static size_t dir_idx(bladerf_direction dir)
+{
+    return (dir == BLADERF_TX) ? 1 : 0;
+}
+
+static void init_sim_state(struct sim_state *s)
+{
+    size_t i;
+    memset(s, 0, sizeof(*s));
+    for (i = 0; i < 4; i++) {
+        s->frequency[i] = 100000000ULL;
+        s->sample_rate[i] = 30720000u;
+        s->bandwidth[i] = 1500000u;
+        s->gain[i] = 60;
+        s->gain_mode[i] = BLADERF_GAIN_DEFAULT;
+        s->stage_gain[i] = 71;
+        s->corr[i][0] = -1;
+        s->corr[i][1] = -1;
+        snprintf(s->rf_port[i], REMOTE_MAX_STR, "%s",
+                 (i == 1 || i == 3) ? "TX1" : "A_BALANCED");
+    }
+    s->rx_mux = BLADERF_RX_MUX_BASEBAND;
+    s->loopback = BLADERF_LB_NONE;
+    s->tuning_mode = BLADERF_TUNING_MODE_HOST;
+    s->config_gpio = 129;
+    s->trim_dac = 8091;
+}
+
+static void fill_sim_iq(struct sim_state *s, int16_t *iq, uint32_t num_samples)
+{
+    uint32_t i;
+    const double dphase = 2.0 * M_PI * 0.05;
+    for (i = 0; i < num_samples; i++) {
+        iq[2 * i] = (int16_t)(1024.0 * cos(s->sim_phase));
+        iq[2 * i + 1] = (int16_t)(1024.0 * sin(s->sim_phase));
+        s->sim_phase += dphase;
+        if (s->sim_phase >= 2.0 * M_PI) {
+            s->sim_phase -= 2.0 * M_PI;
+        }
+    }
+    s->timestamp[0] += num_samples;
+}
+
+static int send_reply(const struct remote_conn *conn,
+                      uint16_t opcode,
+                      int32_t status,
+                      const void *payload,
+                      uint32_t payload_len)
+{
+    struct remote_msg_hdr hdr;
+    int rc;
+
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.magic = REMOTE_PROTO_MAGIC;
+    hdr.opcode = opcode;
+    hdr.status = status;
+    hdr.payload_len = payload_len;
+
+    rc = remote_send_all(conn, &hdr, sizeof(hdr));
+    if (rc == 0 && payload_len > 0 && payload != NULL) {
+        rc = remote_send_all(conn, payload, payload_len);
+    }
+    return rc;
+}
+
+static void populate_hello(struct server_state *srv,
+                           struct remote_hello_resp *h)
+{
+    memset(h, 0, sizeof(*h));
+
+    if (srv->sim) {
+        snprintf(h->board_name, sizeof(h->board_name), "%.*s",
+                 (int)(sizeof(h->board_name) - 1), "bladerf2");
+        snprintf(h->serial, sizeof(h->serial), "%.*s",
+                 (int)(sizeof(h->serial) - 1), "00000000000000000000000000000001");
+        snprintf(h->manufacturer, sizeof(h->manufacturer), "%.*s",
+                 (int)(sizeof(h->manufacturer) - 1), "Nuand");
+        snprintf(h->product, sizeof(h->product), "%.*s",
+                 (int)(sizeof(h->product) - 1), "bladeRF 2.0");
+        h->speed = BLADERF_DEVICE_SPEED_HIGH;
+        h->fpga_size = BLADERF_FPGA_A4;
+        h->fpga_source = BLADERF_FPGA_SOURCE_HOST;
+        h->is_fpga_configured = 1;
+        h->fpga_bytes = 2632660;
+        h->flash_size = 4194304;
+        h->flash_is_guess = 0;
+        h->flash_psize = 256;
+        h->flash_ebsize = 65536;
+        h->fw_major = 2;
+        h->fw_minor = 3;
+        h->fw_patch = 2;
+        snprintf(h->fw_describe, sizeof(h->fw_describe), "%.*s",
+                 (int)(sizeof(h->fw_describe) - 1), "2.3.2");
+        h->fpga_major = 0;
+        h->fpga_minor = 11;
+        h->fpga_patch = 0;
+        snprintf(h->fpga_describe, sizeof(h->fpga_describe), "%.*s",
+                 (int)(sizeof(h->fpga_describe) - 1), "0.11.0");
+        h->capabilities = 0xFFFFFFFFFFFFFFFFULL;
+        h->rx_channels = 2;
+        h->tx_channels = 2;
+        return;
+    }
+
+    pthread_mutex_lock(&srv->dev_lock);
+    {
+        struct bladerf_devinfo di;
+        struct bladerf_version fwv;
+        struct bladerf_version fpgav;
+        bladerf_fpga_size fsz = BLADERF_FPGA_UNKNOWN;
+        bladerf_fpga_source fsrc = BLADERF_FPGA_SOURCE_UNKNOWN;
+        size_t fbytes = 0;
+        uint32_t flsize = 0;
+        bool is_guess = true;
+        const char *bname = bladerf_get_board_name(srv->dev);
+
+        snprintf(h->board_name, sizeof(h->board_name), "%.*s",
+                 (int)(sizeof(h->board_name) - 1), bname ? bname : "bladerf2");
+        if (bladerf_get_devinfo(srv->dev, &di) == 0) {
+            snprintf(h->serial, sizeof(h->serial), "%.*s",
+                     (int)(sizeof(h->serial) - 1), di.serial);
+            snprintf(h->manufacturer, sizeof(h->manufacturer), "%.*s",
+                     (int)(sizeof(h->manufacturer) - 1), di.manufacturer);
+            snprintf(h->product, sizeof(h->product), "%.*s",
+                     (int)(sizeof(h->product) - 1), di.product);
+        } else {
+            (void)bladerf_get_serial(srv->dev, h->serial);
+        }
+
+        h->speed = bladerf_device_speed(srv->dev);
+        if (bladerf_get_fpga_size(srv->dev, &fsz) == 0) h->fpga_size = fsz;
+        if (bladerf_get_fpga_source(srv->dev, &fsrc) == 0) h->fpga_source = fsrc;
+        h->is_fpga_configured = bladerf_is_fpga_configured(srv->dev);
+        if (bladerf_get_fpga_bytes(srv->dev, &fbytes) == 0) h->fpga_bytes = fbytes;
+        if (bladerf_get_flash_size(srv->dev, &flsize, &is_guess) == 0) {
+            h->flash_size = flsize;
+            h->flash_is_guess = is_guess ? 1 : 0;
+        }
+        h->flash_psize = 256;
+        h->flash_ebsize = 65536;
+
+        memset(&fwv, 0, sizeof(fwv));
+        if (bladerf_fw_version(srv->dev, &fwv) == 0) {
+            h->fw_major = fwv.major;
+            h->fw_minor = fwv.minor;
+            h->fw_patch = fwv.patch;
+            if (fwv.describe) {
+                strncpy(h->fw_describe, fwv.describe, sizeof(h->fw_describe) - 1);
+            }
+        }
+
+        memset(&fpgav, 0, sizeof(fpgav));
+        if (bladerf_fpga_version(srv->dev, &fpgav) == 0) {
+            h->fpga_major = fpgav.major;
+            h->fpga_minor = fpgav.minor;
+            h->fpga_patch = fpgav.patch;
+            if (fpgav.describe) {
+                strncpy(h->fpga_describe, fpgav.describe, sizeof(h->fpga_describe) - 1);
+            }
+        }
+
+        h->rx_channels = (uint32_t)bladerf_get_channel_count(srv->dev, BLADERF_RX);
+        h->tx_channels = (uint32_t)bladerf_get_channel_count(srv->dev, BLADERF_TX);
+        h->capabilities = 0xFFFFFFFFFFFFFFFFULL;
+    }
+    pthread_mutex_unlock(&srv->dev_lock);
+}
+
+static size_t format_sample_bytes(int32_t format, uint32_t num_samples)
+{
+    switch ((bladerf_format)format) {
+        case BLADERF_FORMAT_SC8_Q7:
+        case BLADERF_FORMAT_SC8_Q7_META:
+            return (size_t)num_samples * 2u;
+        case BLADERF_FORMAT_SC16_Q11_PACKED:
+            return (size_t)num_samples * 3u;
+        case BLADERF_FORMAT_SC16_Q11:
+        case BLADERF_FORMAT_SC16_Q11_META:
+        case BLADERF_FORMAT_PACKET_META:
+        default:
+            return (size_t)num_samples * 4u;
+    }
+}
+
+static void run_stream_session(struct server_state *srv,
+                               struct remote_conn *conn,
+                               const struct remote_stream_start_req *sreq)
+{
+    size_t buf_bytes = format_sample_bytes(sreq->format, sreq->samples_per_buffer);
+    void *buf;
+    bool is_tx = (sreq->layout == BLADERF_TX_X1 || sreq->layout == BLADERF_TX_X2);
+    int status = 0;
+
+    if (buf_bytes == 0 || buf_bytes > REMOTE_MAX_PAYLOAD) {
+        (void)send_reply(conn, REMOTE_OP_STREAM_START, BLADERF_ERR_INVAL, NULL, 0);
+        return;
+    }
+
+    buf = calloc(1, buf_bytes);
+    if (!buf) {
+        (void)send_reply(conn, REMOTE_OP_STREAM_START, BLADERF_ERR_MEM, NULL, 0);
+        return;
+    }
+
+    if (!srv->sim) {
+        unsigned int num_bufs = sreq->num_buffers;
+        unsigned int timeout_ms = sreq->timeout_ms ? sreq->timeout_ms : 1000u;
+        if (num_bufs <= sreq->num_transfers) {
+            num_bufs = sreq->num_transfers + 2u;
+        }
+        if (num_bufs < 4u) {
+            num_bufs = 4u;
+        }
+        pthread_mutex_lock(&srv->dev_lock);
+        status = bladerf_sync_config(srv->dev,
+                                     (bladerf_channel_layout)sreq->layout,
+                                     (bladerf_format)sreq->format,
+                                     num_bufs,
+                                     sreq->samples_per_buffer,
+                                     sreq->num_transfers ? sreq->num_transfers : 1u,
+                                     timeout_ms);
+        pthread_mutex_unlock(&srv->dev_lock);
+        if (status != 0) {
+            (void)send_reply(conn, REMOTE_OP_STREAM_START, status, NULL, 0);
+            free(buf);
+            return;
+        }
+    }
+
+    if (send_reply(conn, REMOTE_OP_STREAM_START, 0, NULL, 0) != 0) {
+        free(buf);
+        return;
+    }
+
+    for (;;) {
+        struct remote_stream_frame_hdr fhdr;
+        memset(&fhdr, 0, sizeof(fhdr));
+
+        if (!is_tx) {
+            struct bladerf_metadata meta;
+            memset(&meta, 0, sizeof(meta));
+
+            if (srv->sim) {
+                uint32_t rate;
+                pthread_mutex_lock(&srv->dev_lock);
+                fill_sim_iq(&srv->sim_dev, (int16_t *)buf, sreq->samples_per_buffer);
+                fhdr.timestamp = srv->sim_dev.timestamp[0];
+                rate = srv->sim_dev.sample_rate[0];
+                pthread_mutex_unlock(&srv->dev_lock);
+
+                fhdr.status = 0;
+                fhdr.actual_count = sreq->samples_per_buffer;
+                fhdr.byte_len = (uint32_t)buf_bytes;
+
+                if (rate > 0) {
+                    uint64_t us = ((uint64_t)sreq->samples_per_buffer * 1000000ULL) / rate;
+                    uint64_t delay_us = (us > 50000ULL) ? 50000ULL : us;
+                    if (delay_us > 0) {
+                        struct timespec ts;
+                        ts.tv_sec = 0;
+                        ts.tv_nsec = (long)(delay_us * 1000ULL);
+                        nanosleep(&ts, NULL);
+                    }
+                }
+            } else {
+                status = bladerf_sync_rx(srv->dev, buf, sreq->samples_per_buffer,
+                                         &meta,
+                                         sreq->timeout_ms ? sreq->timeout_ms : 1000u);
+                fhdr.status = status;
+                fhdr.timestamp = meta.timestamp;
+                fhdr.flags = meta.flags;
+                fhdr.meta_status = meta.status;
+                fhdr.actual_count = (status == 0) ? sreq->samples_per_buffer : 0u;
+                fhdr.byte_len = (status == 0) ? (uint32_t)buf_bytes : 0u;
+            }
+
+            if (remote_send_all(conn, &fhdr, sizeof(fhdr)) != 0) {
+                break;
+            }
+            if (fhdr.status != 0) {
+                break;
+            }
+            if (fhdr.byte_len > 0 && remote_send_all(conn, buf, fhdr.byte_len) != 0) {
+                break;
+            }
+        } else {
+            struct bladerf_metadata meta;
+            memset(&meta, 0, sizeof(meta));
+
+            if (remote_recv_all(conn, &fhdr, sizeof(fhdr)) != 0) {
+                break;
+            }
+            if (fhdr.byte_len > buf_bytes) {
+                break;
+            }
+            if (fhdr.byte_len > 0 && remote_recv_all(conn, buf, fhdr.byte_len) != 0) {
+                break;
+            }
+            if (!srv->sim) {
+                meta.timestamp = fhdr.timestamp;
+                meta.flags = fhdr.flags;
+                status = bladerf_sync_tx(srv->dev, buf, sreq->samples_per_buffer,
+                                         &meta,
+                                         sreq->timeout_ms ? sreq->timeout_ms : 1000u);
+                if (status != 0) {
+                    break;
+                }
+            }
+        }
+    }
+
+    free(buf);
+}
