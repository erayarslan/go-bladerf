+    status = remote_rpc(&ctx->ctrl, &ctx->ctrl_lock, REMOTE_OP_GET_GAIN_MODES,
+                        &req, sizeof(req), &resp, sizeof(resp), &resp_len);
+    if (status < 0) {
+        return status;
+    }
+    if (resp_len != sizeof(resp)) {
+        return BLADERF_ERR_UNEXPECTED;
+    }
+
+    count = resp.count > REMOTE_MAX_MODES ? REMOTE_MAX_MODES : resp.count;
+    for (i = 0; i < count; i++) {
+        strncpy(bd->gain_mode_names[idx][i], resp.items[i].name, REMOTE_MAX_STR - 1);
+        bd->gain_mode_names[idx][i][REMOTE_MAX_STR - 1] = '\0';
+        bd->gain_modes[idx][i].name = bd->gain_mode_names[idx][i];
+        bd->gain_modes[idx][i].mode = (bladerf_gain_mode)resp.items[i].mode;
+    }
+    bd->num_gain_modes[idx] = (int)count;
+
+    if (modes != NULL) {
